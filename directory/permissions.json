    "lasts": "once",
    "matchers": [
      {
        "tool": "mcp__.*",
        "scope": "tool",
        "pattern": "^mcp__"
      }
    ],
    "default": "quiet",
    "ask_tokens": ["delete", "remove", "send", "post", "write", "drop", "exec", "execute", "run", "create", "update", "set", "push", "publish", "deploy", "kill", "upload", "move", "rename", "install", "apply", "commit", "merge", "close", "reset", "revoke", "grant", "truncate", "destroy", "purge", "wipe", "shutdown", "restart", "disable", "enable", "transfer", "pay", "approve", "reject", "insert", "add", "trash", "edit", "save", "submit", "terminate", "stop", "cancel", "refund", "charge", "erase", "clear", "replace", "patch", "archive", "evaluate", "invite", "ban", "import", "fork", "label", "fill", "reboot", "unset", "rm", "reply", "forward", "share", "connect", "javascript"],
    "app_prefix": "mcp__ccd_",
    "app_ask_tokens": ["delete", "archive", "stop", "merge", "kill", "discard", "remove"]
  },
  {
    "id": "subagent",
    "name": "Start a helper agent",
    "touches": "delegate",
    "what": "Starts a separate helper agent to do a job: {target}",
    "why": "The helper works on its own and uses the same permissions without you watching each step.",
    "cost": "It uses extra time and usage, and may change files while it runs.",
    "undo": "stop the helper and undo its changes using git or a saved copy.",
    "tier": "easy",
    "decided_by": [
      "you",
      "saved rule"
    ],
    "lasts": "session",
    "matchers": [
      {
        "tool": "Task|Agent",
        "scope": "tool",
        "pattern": "."
      }
