    "default": "quiet"
  },
  {
    "id": "infra_change",
    "name": "Change live infrastructure",
    "touches": "run_commands",
    "what": "Changes or removes servers, cloud resources or containers: {target}",
    "why": "These commands act on live systems, often with no confirmation and no recycle bin.",
    "cost": "A website, database or cloud account could go down, lose data, or start costing money.",
    "undo": "only from a backup or by rebuilding it from your config; a rollback or drain can be reversed by hand.",
    "tier": "impossible",
    "decided_by": [
      "you"
    ],
    "lasts": "once",
    "matchers": [
      {
        "tool": "Bash",
        "scope": "seg",
        "pattern": "^(?:\\S*[\\\\/])?(?:terraform|tofu|terragrunt)(?:\\.exe|\\.cmd)?\\b.*?\\s(?:apply|destroy|workspace\\s+delete|state\\s+(?:rm|mv|push))(?=\\s|$)"
      },
      {
        "tool": "Bash",
        "scope": "seg",
        "pattern": "^(?:\\S*[\\\\/])?pulumi(?:\\.exe|\\.cmd)?\\b.*?\\sdestroy(?=\\s|$)"
      },
      {
        "tool": "Bash",
        "scope": "seg",
        "pattern": "^(?:\\S*[\\\\/])?(?:kubectl|oc)(?:\\.exe|\\.cmd)?\\b.*?\\s(?:delete|drain|replace\\s+--force)(?=\\s|$)"
      },
      {
        "tool": "Bash",
        "scope": "seg",
        "pattern": "^(?:\\S*[\\\\/])?helm(?:\\.exe|\\.cmd)?\\b.*?\\s(?:uninstall|delete|rollback)(?=\\s|$)"
      },
      {
        "tool": "Bash",
        "scope": "seg",
        "pattern": "^(?:\\S*[\\\\/])?eksctl(?:\\.exe|\\.cmd)?\\b.*?\\sdelete(?=\\s|$)"
      },
      {
        "tool": "Bash",
        "scope": "seg",
        "pattern": "^(?:\\S*[\\\\/])?aws(?:\\.exe|\\.cmd)?\\b.*?\\s(?:s3\\s+(?:rb|rm)|s3api\\s+delete-\\S+|[\\w-]+\\s+(?:delete|terminate|remove|deregister)-\\S+)(?=\\s|$)"
      },
      {
        "tool": "Bash",
        "scope": "seg",
        "pattern": "^(?:\\S*[\\\\/])?(?:gcloud|az)(?:\\.exe|\\.cmd)?\\b.*?\\sdelete(?=\\s|$)"
      },
      {
        "tool": "Bash",
        "scope": "seg",
        "pattern": "^(?:\\S*[\\\\/])?gsutil(?:\\.exe|\\.cmd)?\\b.*?\\s(?:rm|rb)(?=\\s|$)"
      },
      {
        "tool": "Bash",
        "scope": "seg",
        "pattern": "^(?:\\S*[\\\\/])?(?:docker|podman)(?:\\.exe|\\.cmd)?\\b.*?\\s(?:system\\s+prune|volume\\s+(?:rm|remove|prune))(?=\\s|$)"
      },
      {
        "tool": "Bash",
        "scope": "seg",
        "pattern": "^(?:\\S*[\\\\/])?docker(?:-|\\s+)compose(?:\\.exe|\\.cmd)?\\b.*?\\sdown\\b.*\\s(?:-v|--volumes)(?=\\s|$)"
      }
    ]
  },
  {
